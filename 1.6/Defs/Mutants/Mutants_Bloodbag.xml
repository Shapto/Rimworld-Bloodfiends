<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<MutantDef ParentName="BaseMutantEntity" MayRequire="Ludeon.RimWorld.Anomaly">
		<defName>Bloodfiends_Bloodbag</defName>
		<label>bloodbag</label>
		<description>Mutated, disfigured and transformed by an unrestrained form of Dipsia, Bloodbags are near-mindless thralls entirely subject to their master's whims.\nThe strain of Dipsia they carry is unburdened by suppression archites and highly infectious, capable of spreading via open wounds and bites without the need for transfusion.\nBloodbags retain enough muscle memory to wield guns and perform basic labour, but are otherwise non-cognisant.</description>
		<hediff>Bloodfiends_HardbloodGrowths</hediff>
		<thinkTree>Bloodfiends_Bloodbag</thinkTree>
		<thinkTreeConstant>GhoulConstant</thinkTreeConstant>
		<showJobReport>true</showJobReport>
		<workDisables Inherit="False">
			<li>ManualSkilled</li>
			<li>Intellectual</li>
			<li>Social</li>
			<li>Caring</li>
			<li>Animals</li>
			<li>Artistic</li>
			<li>PlantWork</li>
			<li>Mining</li>
			<li>Constructing</li>
			<li>Crafting</li>
			<li>Cooking</li>
			<li>Firefighting</li>
		</workDisables>
		<whitelistedFloatMenuProviders IsNull="True" />
		<disablesGenes Inherit="False">
			<li MayRequire="Ludeon.RimWorld.Biotech">Deathrest</li>
		</disablesGenes>
		<abilityWhitelist>
			<li>Bloodfiends_Embrace</li>
		</abilityWhitelist>
		<canBleed>true</canBleed>
		<canBeCapturedToHoldingPlatform>false</canBeCapturedToHoldingPlatform>
		<producesBioferrite>false</producesBioferrite>
		<removePermanentInjuries>true</removePermanentInjuries>
		<deathLetter>One of your Bloodbags has died.</deathLetter>
		<modExtensions>
			<li Class="Bloodfiends.Bloodbags.MutantAllowedWorkExtension">
				<allowedWorkTypes>
					<li>Patient</li>
					<li>PatientBedRest</li>
					<li>BasicWorker</li>
					<li>Cleaning</li>
					<li>Hauling</li>
				</allowedWorkTypes>
			</li>
			<li Class="Bloodfiends.Bloodbags.BloodbagExtension">
				<hemogenMaxOffset>2</hemogenMaxOffset>
				<hemogenPerDamage>0.005</hemogenPerDamage>
				<hemogenLossPerDay>0.02</hemogenLossPerDay>
			</li>
		</modExtensions>
		<renderNodeProperties>
			<li>
				<debugLabel>Bloodbag face shadow</debugLabel>
				<nodeClass>Bloodfiends.Hardblood.PawnRenderNode_BloodbagFaceShadow</nodeClass>
				<workerClass>PawnRenderNodeWorker</workerClass>
				<parentTagDef>Head</parentTagDef>
				<baseLayer>50.1</baseLayer>
			</li>
		</renderNodeProperties>
	</MutantDef>
</Defs>
