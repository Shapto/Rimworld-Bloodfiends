<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- hardblood hardening: armor, mantle, replicas, the cocoon -->
  <SoundDef>
    <defName>Bloodfiends_HardbloodForming</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Hardblood/Forming</clipPath>
          </li>
        </grains>
        <volumeRange>30~35</volumeRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_CameraAltitude" />
            <outParam Class="SoundParamTarget_Volume" />
            <curve>
              <points>
                <li>(15, 1)</li>
                <li>(40, 0.4)</li>
                <li>(65, 0)</li>
              </points>
            </curve>
          </li>
        </paramMappings>
      </li>
    </subSounds>
  </SoundDef>

