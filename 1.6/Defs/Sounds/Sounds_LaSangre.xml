<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- the blood winding up around the lance, swelling into the dive -->
  <SoundDef>
    <defName>Bloodfiends_SangreWindup</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>LaSangre/Windup</clipPath>
          </li>
        </grains>
        <volumeRange>28~32</volumeRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_CameraAltitude" />
            <outParam Class="SoundParamTarget_Volume" />
            <curve>
              <points>
                <li>(15, 1)</li>
                <li>(40, 0.4)</li>
                <li>(65, 0)</li>
              </points>
            </curve>
          </li>
        </paramMappings>
      </li>
    </subSounds>
  </SoundDef>

