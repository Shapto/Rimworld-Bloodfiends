<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ScenPartDef>
		<defName>Bloodfiends_StartingTier</defName>
		<label>bloodfiend starting tier</label>
		<scenPartClass>Bloodfiends.Scenarios.ScenPart_BloodfiendStartingTier</scenPartClass>
		<category>Fixed</category>
		<selectionWeight>0</selectionWeight>
		<summaryPriority>490</summaryPriority>
	</ScenPartDef>

	<!-- ========== First Kindred ========== -->

	<ScenarioDef ParentName="ScenarioBase">
		<defName>Bloodfiends_FirstKindred</defName>
		<label>First Kindred</label>
		<description>Something old woke in your veins on the voyage. Now your pod has crashed and the two survivors beside you have no idea what you've become. the Family begins with you.\n\nStarts with a First Kindred Bloodfiend founding a new Family, and two other colonists.</description>
		<scenario>
			<summary>A newly risen First Kindred and two unwitting survivors. Your Family starts here.</summary>
			<parts>

				<!-- Config pages -->
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
					<def>ConfigurePawnsXenotypes</def>
					<pawnChoiceCount>8</pawnChoiceCount>
					<customSummary>Start with one adult or child Bloodfiend and two other colonists of any age.</customSummary>
					<xenotypeCounts>
						<li>
							<xenotype>Bloodfiends_Bloodfiend</xenotype>
							<count>1</count>
							<description>non-baby bloodfiend</description>
							<requiredAtStart>true</requiredAtStart>
							<allowedDevelopmentalStages>Adult, Child</allowedDevelopmentalStages>
						</li>
						<li>
							<xenotype>Baseliner</xenotype>
							<count>2</count>
						</li>
					</xenotypeCounts>
				</li>
				<li Class="Bloodfiends.Scenarios.ScenPart_BloodfiendStartingTier">
					<def>Bloodfiends_StartingTier</def>
					<generation>1</generation>
				</li>

				<!-- Player starting stuff spawn method -->
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>DropPods</method>
					<visible>false</visible>
				</li>

				<!-- Player pawns modifiers -->
				<li Class="ScenPart_ForcedHediff">
					<def>ForcedHediff</def>
					<visible>false</visible>
					<context>PlayerStarter</context>
					<chance>0.5</chance>
					<hediff>CryptosleepSickness</hediff>
					<hideOffMap>true</hideOffMap>
					<severityRange>1~1</severityRange>
				</li>

				<!-- Player starting things -->
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>800</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MealSurvivalPack</thingDef>
					<count>50</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineIndustrial</thingDef>
					<count>30</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ComponentIndustrial</thingDef>
					<count>30</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Gun_BoltActionRifle</thingDef>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Gun_Revolver</thingDef>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MeleeWeapon_Knife</thingDef>
					<stuff>Plasteel</stuff>
				</li>
				<li Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
					<count>1</count>
					<bondToRandomPlayerPawnChance>1.0</bondToRandomPlayerPawnChance>
				</li>

				<!-- Scatter some things near player start -->
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>Steel</thingDef>
					<count>450</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>300</count>
				</li>

				<!-- Scatter some things anywhere -->
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>ShipChunk</thingDef>
					<allowRoofed>false</allowRoofed>
					<count>3</count>
				</li>
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>Steel</thingDef>
					<count>720</count>
				</li>

				<!-- Game start dialog -->
				<li Class="ScenPart_GameStartDialog">
					<def>GameStartDialog</def>
					<text>The pod is a smoking wreck. The others are shaken but alive, and you can hear their hearts.\n\nYou are a First Kindred: the root of a new Family, bound to no elder. Every Kindred you embrace will answer to you.\n\nFeed carefully. Fire is your enemy, and so is water.</text>
					<closeSound>GameStartSting</closeSound>
				</li>

			</parts>
		</scenario>
	</ScenarioDef>

