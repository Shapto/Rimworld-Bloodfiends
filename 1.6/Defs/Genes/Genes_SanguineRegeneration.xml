<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<GeneDef>
		<defName>Bloodfiends_SanguineRegeneration</defName>
		<label>sanguine regeneration</label>
		<description>Carriers of this gene possess exceptional regenerative abilities fueled by hemogen. As long as a sufficient is present, bleeding wounds immediately coagulate and scab over, crushed bones reset and mend on their own, and severed limbs regrow in a matter of seconds. Due to the complex tissue damage they cause, burns are a third as fast to heal and cost significantly more hemogen when compared to other wounds.</description>
		<geneClass>Bloodfiends.SanguineRegeneration.Gene_SanguineRegeneration</geneClass>
		<iconPath>Icons/Healing</iconPath>
		<displayCategory>Bloodfiends_Bloodfiend</displayCategory>
		<prerequisite>Hemogenic</prerequisite>
		<biostatArc>1</biostatArc>
		<modExtensions>
			<li Class="Bloodfiends.SanguineRegeneration.SanguineRegenerationExtension">
				<regenerationIntervalTicks>60</regenerationIntervalTicks>
				<hemogenReserveFraction>0.1</hemogenReserveFraction>
				<healingPerPassByGeneration>
					<points>
						<li>(1, 2.0)</li>
						<li>(7, 0.5)</li>
					</points>
				</healingPerPassByGeneration>
				<slowHealingInjuries>
					<li>Burn</li>
					<li>ChemicalBurn</li>
				</slowHealingInjuries>
				<hemogenPerHealedPoint>0.002</hemogenPerHealedPoint>
				<regrowthCostMultiplier>3</regrowthCostMultiplier>
				<bloodLossHealedPerPass>0.02</bloodLossHealedPerPass>
				<hemogenPerBloodLossSeverity>0.2</hemogenPerBloodLossSeverity>
				<mortalStateDrainPerPass>0.01</mortalStateDrainPerPass>
			</li>
		</modExtensions>
	</GeneDef>
</Defs>
