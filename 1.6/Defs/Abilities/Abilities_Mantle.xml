				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="CompProperties_AbilityHemogenCost">
				<hemogenCost>0.3</hemogenCost>
			</li>
			<li Class="Bloodfiends.Mantle.CompProperties_AbilityMantle">
				<mantleHediff>Bloodfiends_HardbloodMantle</mantleHediff>
				<maximumCasterGeneration>3</maximumCasterGeneration>
			</li>
		</comps>
	</AbilityDef>
