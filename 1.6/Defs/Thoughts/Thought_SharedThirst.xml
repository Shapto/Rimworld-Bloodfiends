<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThoughtDef>
		<defName>Bloodfiends_BurdenOfTheFamily</defName>
		<workerClass>Bloodfiends.SharedThirst.ThoughtWorker_BurdenOfTheFamily</workerClass>
		<developmentalStageFilter>Child, Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>Burden of the Family</label>
				<description>I long for a family of my own.</description>
				<baseMoodEffect>-10</baseMoodEffect>
			</li>
			<li>
				<label>Burden of the Family</label>
				<description>The family is yet too small.</description>
				<baseMoodEffect>-7</baseMoodEffect>
			</li>
			<li>
				<label>Burden of the Family</label>
				<description>The family must yet grow.</description>
				<baseMoodEffect>-4</baseMoodEffect>
			</li>
			<li>
				<label>Burden of the Family</label>
				<description>The family nears its pinnacle.</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
		</stages>
		<modExtensions>
			<li Class="Bloodfiends.SharedThirst.BurdenOfTheFamilyExtension">
				<stageMaximumOtherMembers>
					<li>0</li>
					<li>2</li>
					<li>4</li>
					<li>6</li>
				</stageMaximumOtherMembers>
			</li>
		</modExtensions>
	</ThoughtDef>

	<ThoughtDef>
		<defName>Bloodfiends_FamilyBond</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>Bloodfiends.SharedThirst.ThoughtWorker_FamilyBond</workerClass>
		<stages>
			<li>
				<label>family</label>
				<baseOpinionOffset>30</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>

	<!-- an elder struck me: discipline, a small sting -->
	<ThoughtDef>
		<defName>Bloodfiends_ChastisedByElder</defName>
		<thoughtClass>Thought_Memory</thoughtClass>
		<durationDays>1</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>chastised by an elder</label>
				<description>An elder has struck me! I must right my wrongs.</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<!-- I struck a Kindred of my own tier -->
	<ThoughtDef>
		<defName>Bloodfiends_SiblingQuarrel</defName>
		<thoughtClass>Thought_Memory</thoughtClass>
		<durationDays>2</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>quarrelled with a sibling</label>
				<description>I've quarelled with my own blood. Whatever the reason may have been, it's not a good feeling.</description>
				<baseMoodEffect>-4</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<!-- I struck an elder: stage by how far above me (1 tier, 2 tiers, 3 or more) -->
	<ThoughtDef>
		<defName>Bloodfiends_FamilialImpiety</defName>
		<thoughtClass>Thought_Memory</thoughtClass>
		<durationDays>5</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>filial impiety</label>
				<description>I've struck a superior! The shame!</description>
				<baseMoodEffect>-12</baseMoodEffect>
			</li>
			<li>
				<label>grave impiety</label>
				<description>I've struck an elder! The impiety! The dishonor!</description>
				<baseMoodEffect>-18</baseMoodEffect>
			</li>
			<li>
				<label>unforgivable impiety</label>
				<description>I have comitted an unforgivable sin against my brethren. I ask for no forgiveness as I deserve none...</description>
				<baseMoodEffect>-25</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<!-- a lower Kindred struck me: the elder holds it against them -->
	<ThoughtDef>
		<defName>Bloodfiends_StruckByLesserKindred</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>10</durationDays>
		<stackLimit>3</stackLimit>
		<stackedEffectMultiplier>0.9</stackedEffectMultiplier>
		<stages>
			<li>
				<label>struck by a lesser Kindred</label>
				<baseOpinionOffset>-20</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>

	<!-- I killed an elder of my own Family -->
	<ThoughtDef>
		<defName>Bloodfiends_KilledElder</defName>
		<thoughtClass>Thought_Memory</thoughtClass>
		<durationDays>20</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>killed an elder</label>
				<description>I have comitted the primordial sin against my own blood. My veins scream at me, my brethren shun me. I deserve nothing.</description>
				<baseMoodEffect>-30</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef>
		<defName>Bloodfiends_EmbracedWillingly</defName>
		<thoughtClass>Thought_Memory</thoughtClass>
		<durationDays>6</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>embraced</label>
				<description>What... is this? I feel younger, faster, sharper... I feel invincible!</description>
				<baseMoodEffect>6</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef>
		<defName>Bloodfiends_TurnedAgainstWill</defName>
		<thoughtClass>Thought_Memory</thoughtClass>
		<durationDays>20</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>turned against my will</label>
				<description>What did they do to me? My eyes! My teeth! I've been made a monster!</description>
				<baseMoodEffect>-15</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef>
		<defName>Bloodfiends_TurnedMeAgainstWill</defName>
		<thoughtClass>Thought_MemorySocial</thoughtClass>
		<durationDays>30</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>turned me against my will</label>
				<baseOpinionOffset>-40</baseOpinionOffset>
			</li>
		</stages>
	</ThoughtDef>
</Defs>
