<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef>
		<defName>Bloodfiends_Withering</defName>
		<label>withering</label>
		<description>Sharp pangs of pain cramp throughout the heart and veins. Without blood, a hemogenic pawn will soon grow frail and regress to their primal predatory instincts, attacking anything in sight in order to quench their thirst.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.75, 0.1, 0.1)</defaultLabelColor>
		<isBad>true</isBad>
		<maxSeverity>1</maxSeverity>
		<lethalSeverity>1</lethalSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<label>parched</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.1</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.1</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.35</minSeverity>
				<label>starved</label>
				<painOffset>0.15</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.25</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.25</offset>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.2</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.7</minSeverity>
				<label>withered</label>
				<painOffset>0.3</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.45</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.45</offset>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.4</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.85</minSeverity>
				<label>ravenous</label>
				<lifeThreatening>true</lifeThreatening>
				<painOffset>0.3</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.45</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.45</offset>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.4</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
</Defs>
