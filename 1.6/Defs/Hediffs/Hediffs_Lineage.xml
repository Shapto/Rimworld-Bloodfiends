          <MoveSpeed>1.04</MoveSpeed>
          <MeleeDamageFactor>1.04</MeleeDamageFactor>
          <IncomingDamageFactor>0.97</IncomingDamageFactor>
        </statFactors>
        <statOffsets>
          <PsychicSensitivity>0.08</PsychicSensitivity>
          <MeditationFocusGain MayRequire="Ludeon.RimWorld.Royalty">0.02</MeditationFocusGain>
          <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.02</PsychicEntropyRecoveryRate>
