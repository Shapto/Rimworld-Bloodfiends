<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>Bloodfiends_Lineage</defName>
    <label>bloodfiend</label>
    <description>This pawn's place in the family hierarchy.</description>
    <hediffClass>Bloodfiends.Family.Hediff_BloodfiendLineage</hediffClass>
    <defaultLabelColor>(0.75, 0.1, 0.1)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>99</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>First Kindred</label>
        <statFactors>
          <MoveSpeed>1.48</MoveSpeed>
          <MeleeDamageFactor>1.5</MeleeDamageFactor>
          <IncomingDamageFactor>0.6</IncomingDamageFactor>
        </statFactors>
        <statOffsets>
          <PsychicSensitivity>1.0</PsychicSensitivity>
          <MeditationFocusGain MayRequire="Ludeon.RimWorld.Royalty">0.2</MeditationFocusGain>
          <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.2</PsychicEntropyRecoveryRate>
          <MeleeHitChance>0.15</MeleeHitChance>
          <PainShockThreshold>0.4</PainShockThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>Second Kindred</label>
        <statFactors>
          <MoveSpeed>1.35</MoveSpeed>
          <MeleeDamageFactor>1.37</MeleeDamageFactor>
          <IncomingDamageFactor>0.71</IncomingDamageFactor>
        </statFactors>
        <statOffsets>
          <PsychicSensitivity>0.73</PsychicSensitivity>
          <MeditationFocusGain MayRequire="Ludeon.RimWorld.Royalty">0.15</MeditationFocusGain>
          <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.15</PsychicEntropyRecoveryRate>
          <MeleeHitChance>0.11</MeleeHitChance>
          <PainShockThreshold>0.29</PainShockThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>Third Kindred</label>
        <statFactors>
          <MoveSpeed>1.24</MoveSpeed>
          <MeleeDamageFactor>1.26</MeleeDamageFactor>
          <IncomingDamageFactor>0.8</IncomingDamageFactor>
        </statFactors>
        <statOffsets>
          <PsychicSensitivity>0.51</PsychicSensitivity>
          <MeditationFocusGain MayRequire="Ludeon.RimWorld.Royalty">0.1</MeditationFocusGain>
          <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.1</PsychicEntropyRecoveryRate>
          <MeleeHitChance>0.08</MeleeHitChance>
          <PainShockThreshold>0.2</PainShockThreshold>
        </statOffsets>
      </li>
      <li>
