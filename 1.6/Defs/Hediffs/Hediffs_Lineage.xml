          <MoveSpeed>1.16</MoveSpeed>
          <MeleeDamageFactor>1.16</MeleeDamageFactor>
          <IncomingDamageFactor>0.87</IncomingDamageFactor>
        </statFactors>
        <statOffsets>
          <PsychicSensitivity>0.33</PsychicSensitivity>
          <MeditationFocusGain MayRequire="Ludeon.RimWorld.Royalty">0.07</MeditationFocusGain>
          <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.07</PsychicEntropyRecoveryRate>
          <MeleeHitChance>0.05</MeleeHitChance>
          <PainShockThreshold>0.13</PainShockThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>5</minSeverity>
