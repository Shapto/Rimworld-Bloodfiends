    <modExtensions>
      <li Class="Bloodfiends.Family.LineageHemogenExtension">
        <hemogenMaxOffsetByGeneration>
          <points>
            <li>(1, 3.0)</li>
            <li>(7, 0.43)</li>
            <li>(8, 0)</li>
          </points>
        </hemogenMaxOffsetByGeneration>
      </li>
    </modExtensions>
  </HediffDef>

	<HediffDef>
		<defName>Bloodfiends_EmbraceWeakness</defName>
		<label>drained by the embrace</label>
		<description>This person has been drained by embracing another pawn. They will take three days to recover from the shedding of genetic material and abrupt bloodloss.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.75, 0.1, 0.1)</defaultLabelColor>
		<isBad>true</isBad>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>180000~180000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.15</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.2</offset>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.1</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
</Defs>
