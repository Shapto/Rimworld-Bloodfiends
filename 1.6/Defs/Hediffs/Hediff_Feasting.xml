<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef>
		<defName>Bloodfiends_Feasting</defName>
		<label>feasting</label>
		<description>Elevated hemogen quantity in the metabolic system. Enhances physical capabilities beyond their baseline.</description>
		<hediffClass>Bloodfiends.SharedThirst.Hediff_Feasting</hediffClass>
		<defaultLabelColor>(0.75, 0.1, 0.1)</defaultLabelColor>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<stages>
			<li>
				<minSeverity>0</minSeverity>
			</li>
			<li>
				<minSeverity>0.7</minSeverity>
				<label>sated</label>
				<capMods>
					<li>
						<capacity>Manipulation</capacity>
						<offset>0.1</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>0.1</offset>
					</li>
					<li>
						<capacity>Sight</capacity>
						<offset>0.05</offset>
					</li>
					<li>
						<capacity>Consciousness</capacity>
						<offset>0.03</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.9</minSeverity>
				<label>gorged</label>
				<capMods>
					<li>
						<capacity>Manipulation</capacity>
						<offset>0.2</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>0.2</offset>
					</li>
					<li>
						<capacity>Sight</capacity>
						<offset>0.1</offset>
					</li>
					<li>
						<capacity>Breathing</capacity>
						<offset>0.1</offset>
					</li>
					<li>
						<capacity>Consciousness</capacity>
						<offset>0.05</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
</Defs>
